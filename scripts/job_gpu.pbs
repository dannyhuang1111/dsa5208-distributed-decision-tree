#!/bin/bash
# PBS Pro job for the GPU (CUDA) arm.  Models scripts/job_scaling.pbs but asks
# for a GPU node, builds src/tree_cuda.cu with nvcc, and runs the histogram
# benchmark.  Submit with:   qsub scripts/job_gpu.pbs
#
# GPU specs below are from the team's Vanda GPU run (single A40, confirmed on
# Vanda): queue 'gpu', one GPU + 4 CPU cores, module cuda12.2/toolkit/12.2.2.
# Adjust if your Vanda allocation differs (`qstat -Q`, `module avail cuda`).
#PBS -N dt_gpu
#PBS -q gpu
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=4:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1

[ -f /app1/ebenv ] && source /app1/ebenv
# Vanda CUDA toolkit (confirmed); fall back to a generic cuda module elsewhere.
module load cuda12.2/toolkit/12.2.2 2>/dev/null || module load cuda 2>/dev/null || { echo "no cuda module -- fix the module load line"; exit 1; }
# A host C++17 compiler for the serial baseline comparison (foss gives GCC 12).
module load foss/2022b 2>/dev/null || true

# Build the GPU binary and the serial baseline (for the GPU-vs-CPU comparison).
make -f Makefile.dt cuda || { echo "nvcc build failed"; exit 1; }
make -f Makefile.dt build/dt_serial || true

N=${N:-32000000}
F=${F:-28}
REPS=${REPS:-3}

RUN_ID=${RUN_ID:-$(date +%Y%m%d_%H%M%S)}
[ -n "${PBS_JOBID:-}" ] && RUN_ID="${RUN_ID}_${PBS_JOBID%%.*}"
RAW=results/raw; LOGS=results/logs
mkdir -p "$RAW" "$LOGS"
GPU_CSV="$RAW/gpu_${RUN_ID}.csv"
LOG="$LOGS/gpu_${RUN_ID}.log"

echo "run_id=$RUN_ID N=$N F=$F reps=$REPS" | tee "$LOG"
nvidia-smi 2>&1 | head -15 | tee -a "$LOG" || true

# GPU run.  RESULT_GPU line -> gpu CSV; full output -> log.
./build/dt_cuda --synthetic "$N" --features "$F" --reps "$REPS" 2>>"$LOG" | tee -a "$LOG" | grep '^RESULT_GPU,' > "$GPU_CSV"

# Serial baseline on the SAME problem, for the GPU-vs-one-core comparison.
if [ -x build/dt_serial ]; then
  echo "--- serial baseline (same N,F) ---" | tee -a "$LOG"
  ./build/dt_serial --synthetic "$N" --features "$F" --reps "$REPS" --quiet 2>>"$LOG" | tee -a "$LOG" | grep '^RESULT,' >> "$GPU_CSV"
fi

echo "GPU results -> $GPU_CSV"
echo "Compare: dt_cuda t_kernel/t_total vs the serial RESULT t_total, and vs a"
echo "full MPI+OpenMP node from the strong-scaling run (results/raw/strong_*.csv)."
