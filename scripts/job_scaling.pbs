#!/bin/bash
# PBS Pro job for NUS Vanda.  NOT TESTED here: run with EXPERIMENTS="smoke"
# first (a few minutes) and read results/logs before the big 256-core run.
#
#   qsub -v EXPERIMENTS="smoke" scripts/job_scaling.pbs                       # sanity
#   qsub scripts/job_scaling.pbs                                              # full run
#
# CLUSTER-SPECIFIC values to CONFIRM on Vanda (cannot verify from here):
#   * queue name         -> `qstat -Q`                        (the -q line below)
#   * cores per node     -> `pbsnodes -a | grep ncpus`        (adjust select= below)
#   * module name        -> `module avail` (GCC >= 9 + an MPI) (module load line)
#   * rank placement     -> add --report-bindings to MPI_BIND for the smoke run
#
# 256 cores.  The select line asks for 256 cores total; set ncpus per chunk to
# Vanda's cores-per-node and the chunk count so chunks*ncpus = 256.  Example
# below assumes 64-core nodes (4 chunks x 64 = 256); change to match Vanda.
# mpiprocs=ncpus makes $PBS_NODEFILE list one line per core (run_matrix.sh reads
# it as MAX_CORES).
#PBS -N dt_scaling
#PBS -q normal
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1

[ -f /app1/ebenv ] && source /app1/ebenv
# TODO: load Vanda's toolchain (GCC >=9 for C++17 + an MPI). foss/* bundles both.
module load foss/2022b || { echo "fix the module load line for Vanda"; exit 1; }

make -f Makefile.dt clean all || exit 1

# Correctness gate: refuse to benchmark a build that disagrees with the serial reference.
N=200003 RANKS="1 2 3 4" THREADS="1 2 4" scripts/check_equivalence.sh || { echo "equivalence check FAILED, not benchmarking"; exit 1; }

# Problem sizes (override with qsub -v ...).  Sized for ~10 min longest run on a
# cluster ~3x slower than the 48-core dev box; see EXPERIMENTS.md.
export N_STRONG=${N_STRONG:-32000000}
export F_SWEEP=${F_SWEEP:-"7 14 28 56"}
export N_PER_RANK=${N_PER_RANK:-1000000}
export RANK_LIST=${RANK_LIST:-"1 2 4 8 16 32 64 128 256"}
export THREAD_LIST=${THREAD_LIST:-"1 2 4 8 16 32 64 128 256"}
export HYBRID_CORES=${HYBRID_CORES:-256}
export HYB_THREADS=${HYB_THREADS:-4}
export REPS=${REPS:-3}
export LAUNCHES=${LAUNCHES:-1}
export REAL_CSV=${REAL_CSV:-}

bash scripts/run_matrix.sh ${EXPERIMENTS:-serial_scan strong weak hybrid design}

